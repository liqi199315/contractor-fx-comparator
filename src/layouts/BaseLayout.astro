---
import '../styles/global.css';
import { ROUTE_PRESETS } from '../lib/route-presets';
import type { RouteFaqItem } from '../lib/types';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	faqs?: RouteFaqItem[];
	noindex?: boolean;
}

const { title, description, canonicalPath, faqs = [], noindex = false } = Astro.props;

const siteOrigin = (
	import.meta.env.PUBLIC_SITE_URL ||
	Astro.site?.toString() ||
	'https://contractorfx.com'
).replace(/\/$/, '');

const normalizedPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${siteOrigin}${normalizedPath}`;
const ogImageUrl = `${siteOrigin}/og-image.png`;

const resolvedFaqs = Array.isArray(faqs)
	? faqs.filter((faq) => Boolean(faq?.question?.trim() && faq?.answer?.trim()))
	: [];

const ga4MeasurementId =
	(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || '').trim() || 'G-PENDING000';
const clarityProjectId = (import.meta.env.PUBLIC_CLARITY_PROJECT_ID || '').trim();

const ga4InlineBootstrap = `(function(){
if(window.__contractorFxAnalyticsBootstrap)return;
window.__contractorFxAnalyticsBootstrap=true;
var measurementId=${JSON.stringify(ga4MeasurementId)};
var clarityId=${JSON.stringify(clarityProjectId)};
window.dataLayer=window.dataLayer||[];
function queueGtag(){window.dataLayer.push(arguments);}
function analyticsPageLocation(){
try{
var safe=new URL(location.origin+location.pathname);
var original=new URL(location.href);
var campaign=['utm_source','utm_medium','utm_campaign','utm_id','utm_term','utm_content','utm_source_platform','utm_creative_format','utm_marketing_tactic'];
var clickIds=['gclid','dclid','gbraid','wbraid','msclkid'];
var allowed=campaign.concat(clickIds);
for(var i=0;i<allowed.length;i++){
var key=allowed[i];
var values=original.searchParams.getAll(key);
if(values.length!==1)continue;
var value=values[0];
var pattern=clickIds.indexOf(key)!==-1?/^[A-Za-z0-9_.~-]{1,256}$/:/^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S}\\p{Zs}]{1,200}$/u;
var suspicious=/@|:\\/\\/|\\\\|%[0-9a-f]{2}|(?:token|password|secret|salary|amount|invoice|contractor|csv)\\s*=/i.test(value);
if(pattern.test(value)&&!suspicious){
safe.searchParams.set(key,value);
}
}
return safe.href;
}catch(_e){
return location.origin+location.pathname;
}
}
function analyticsPageReferrer(){
try{
if(!document.referrer)return '';
var ref=new URL(document.referrer);
return (ref.protocol==='https:'||ref.protocol==='http:')?ref.origin+'/':'';
}catch(_e){
return '';
}
}
function gtag(){
if(arguments[0]==='event'){
var rawParams=arguments[2]&&typeof arguments[2]==='object'?arguments[2]:{};
var params=Object.assign({},rawParams,{
page_location:analyticsPageLocation(),
page_referrer:analyticsPageReferrer()
});
return queueGtag('event',arguments[1],params);
}
return queueGtag.apply(null,arguments);
}
window.gtag=gtag;
gtag('js',new Date());
var safePage={
page_location:analyticsPageLocation(),
page_referrer:analyticsPageReferrer(),
anonymize_ip:true
};
gtag('set',{
page_location:safePage.page_location,
page_referrer:safePage.page_referrer
});
gtag('config',measurementId,safePage);
var lastIdentity=location.pathname+location.search;
var previousVirtualPage=location.origin+location.pathname;
function trackNavigation(){
var identity=location.pathname+location.search;
if(identity===lastIdentity)return;
var referrer=previousVirtualPage;
lastIdentity=identity;
previousVirtualPage=location.origin+location.pathname;
queueGtag('event','page_view',{
page_location:analyticsPageLocation(),
page_referrer:referrer
});
}
if(!window.__contractorFxNavInit){
window.__contractorFxNavInit=true;
['pushState','replaceState'].forEach(function(method){
var original=history[method];
if(typeof original==='function'){
history[method]=function(){
var result=original.apply(this,arguments);
trackNavigation();
return result;
};
}
});
window.addEventListener('popstate',trackNavigation);
}
var host=location.hostname;
var isLocalHost=host==='localhost'||host==='127.0.0.1'||host==='[::1]'||host==='::1'||/\\.localhost$/i.test(host);
var isRealGa4Id=/^G-[A-Z0-9]{4,20}$/i.test(measurementId)&&measurementId.toUpperCase()!=='G-PENDING000'&&!/^G-X+$/i.test(measurementId);
if(isRealGa4Id&&!isLocalHost){
var tag=document.createElement('script');
tag.async=true;
tag.src='https://www.googletagmanager.com/gtag/js?id='+encodeURIComponent(measurementId);
document.head.appendChild(tag);
}
if(/^[A-Za-z0-9]{6,24}$/.test(clarityId)&&!isLocalHost){
(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){
(c[a].q=c[a].q||[]).push(arguments);
};
t=l.createElement(r);
t.async=1;
t.src='https://www.clarity.ms/tag/'+encodeURIComponent(i);
y=l.getElementsByTagName(r)[0];
y.parentNode.insertBefore(t,y);
})(window,document,'clarity','script',clarityId);
}
})();`;

const staticRouteLabels: Record<string, string> = {
	'/about/': 'About & Methodology',
	'/privacy/': 'Privacy Policy',
	'/terms/': 'Terms of Use',
};

const activePreset = ROUTE_PRESETS.find((item) => item.path === normalizedPath);
const currentBreadcrumbLabel =
	activePreset?.navLabel ||
	staticRouteLabels[normalizedPath] ||
	title.split('|')[0]?.trim() ||
	'Calculator';

const breadcrumbItems: Record<string, unknown>[] = [
	{
		'@type': 'ListItem',
		position: 1,
		name: 'ContractorFX',
		item: `${siteOrigin}/`,
	},
];

if (normalizedPath !== '/') {
	breadcrumbItems.push({
		'@type': 'ListItem',
		position: 2,
		name: currentBreadcrumbLabel,
		item: canonicalUrl,
	});
}

const organizationId = `${siteOrigin}/#organization`;

const schemaGraph: Record<string, unknown>[] = [
	{
		'@type': 'Organization',
		'@id': organizationId,
		name: 'ContractorFX',
		url: `${siteOrigin}/`,
		logo: {
			'@type': 'ImageObject',
			url: `${siteOrigin}/favicon.svg`,
		},
		description:
			'Independent browser-local international contractor payout fee and FX spread comparator across Wise, Payoneer, Deel, Remote, and SWIFT bank wires.',
	},
	{
		'@type': 'BreadcrumbList',
		'@id': `${canonicalUrl}#breadcrumb`,
		itemListElement: breadcrumbItems,
	},
	{
		'@type': 'WebApplication',
		'@id': `${canonicalUrl}#webapp`,
		name: title,
		description,
		url: canonicalUrl,
		image: ogImageUrl,
		applicationCategory: 'FinanceApplication',
		operatingSystem: 'Any',
		browserRequirements: 'Requires JavaScript for live FX scenario modeling and local CSV roster auditing.',
		isAccessibleForFree: true,
		publisher: {
			'@id': organizationId,
		},
		offers: {
			'@type': 'Offer',
			price: '0',
			priceCurrency: 'USD',
		},
	},
];

if (resolvedFaqs.length > 0) {
	schemaGraph.push({
		'@type': 'FAQPage',
		'@id': `${canonicalUrl}#faq`,
		mainEntity: resolvedFaqs.map((faq) => ({
			'@type': 'Question',
			name: faq.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: faq.answer,
			},
		})),
	});
}

const jsonLdString = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': schemaGraph,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0f172a" />
		{
			noindex ? (
				<meta name="robots" content="noindex, follow" />
			) : (
				<meta
					name="robots"
					content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
				/>
			)
		}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ContractorFX" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="ContractorFX international contractor payout fee and FX spread comparator"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta
			name="twitter:image:alt"
			content="ContractorFX international contractor payout fee and FX spread comparator"
		/>
		{!noindex && <script is:inline type="application/ld+json" set:html={jsonLdString} />}
		<script is:inline set:html={ga4InlineBootstrap} />
	</head>
	<body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-xs focus:font-semibold focus:text-white focus:shadow-lg"
		>
			Skip to main content
		</a>

		<div class="border-b border-slate-800 bg-slate-900 px-4 py-2 text-xs text-slate-300">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2">
				<span>
					Reference mid-market rates and published schedule estimates as of Nov 2026; verify live checkout quotes before transfer.
				</span>
				<span class="font-medium text-emerald-400">
					Zero server uploads: invoices and CSV rosters stay in browser memory
				</span>
			</div>
		</div>

		<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
			<div class="mx-auto max-w-6xl px-4 py-3.5">
				<div class="flex items-center justify-between gap-3">
					<div class="flex min-w-0 flex-wrap items-center gap-2.5 sm:gap-3">
						<a
							href="/"
							class="inline-flex items-center gap-2.5 text-slate-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 rounded-lg"
						>
							<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-xs font-extrabold tracking-tight text-emerald-400 shadow-xs">
								FX
							</span>
							<span class="flex flex-col">
								<span class="text-base font-bold leading-tight tracking-tight sm:text-lg">
									ContractorFX
								</span>
								<span class="hidden text-[11px] font-medium text-slate-500 sm:inline">
									Global Payout &amp; Spread Lab
								</span>
							</span>
						</a>

						<span
							class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-800"
							title="All invoice math and CSV payroll audits execute locally inside your browser"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 20 20"
								fill="currentColor"
								aria-hidden="true"
								class="h-3.5 w-3.5 shrink-0 text-emerald-600"
							>
								<path
									fill-rule="evenodd"
									d="M10 1.5a.75.75 0 0 1 .38.103l6 3.5A.75.75 0 0 1 16.75 5.75v4.31c0 4.06-2.668 7.648-6.535 8.898a.75.75 0 0 1-.43 0C5.918 17.708 3.25 14.12 3.25 10.06V5.75a.75.75 0 0 1 .37-.647l6-3.5A.75.75 0 0 1 10 1.5Zm3.03 6.22a.75.75 0 0 0-1.06-1.06L9.25 9.38 8.03 8.16a.75.75 0 0 0-1.06 1.06l1.75 1.75a.75.75 0 0 0 1.06 0l3.25-3.25Z"
									clip-rule="evenodd"
								/>
							</svg>
							<span>100% Local Payroll Privacy</span>
						</span>
					</div>

					<nav
						aria-label="Primary corridors and calculators"
						class="hidden lg:flex lg:flex-wrap lg:items-center lg:justify-end lg:gap-1"
					>
						{
							ROUTE_PRESETS.map((routeItem) => {
								const isCurrent = routeItem.path === normalizedPath;
								return (
									<a
										href={routeItem.path}
										aria-current={isCurrent ? 'page' : undefined}
										class:list={[
											'rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors',
											isCurrent
												? 'bg-slate-900 text-white shadow-xs'
												: 'text-slate-700 hover:bg-slate-100 hover:text-slate-900',
										]}
									>
										{routeItem.navLabel}
									</a>
								);
							})
						}
						<a
							href="/about/"
							aria-current={normalizedPath === '/about/' ? 'page' : undefined}
							class:list={[
								'rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors',
								normalizedPath === '/about/'
									? 'bg-slate-900 text-white shadow-xs'
									: 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
							]}
						>
							Methodology
						</a>
					</nav>

					<details class="group relative lg:hidden">
						<summary
							aria-label="Toggle corridor calculators menu"
							class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-800 transition-colors hover:bg-slate-100 [&::-webkit-details-marker]:hidden"
						>
							<span>Corridors</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 20 20"
								fill="currentColor"
								aria-hidden="true"
								class="h-4 w-4 text-slate-600 transition-transform group-open:rotate-180"
							>
								<path
									fill-rule="evenodd"
									d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
									clip-rule="evenodd"
								/>
							</svg>
						</summary>

						<div class="absolute right-0 top-full z-50 mt-2 w-[min(22rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-3 shadow-xl">
							<p class="px-2 pb-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-400">
								Corridor Calculators
							</p>
							<nav aria-label="Mobile corridor navigation" class="flex flex-col gap-1">
								{
									ROUTE_PRESETS.map((routeItem) => {
										const isCurrent = routeItem.path === normalizedPath;
										return (
											<a
												href={routeItem.path}
												aria-current={isCurrent ? 'page' : undefined}
												class:list={[
													'flex items-center justify-between rounded-lg px-2.5 py-2 text-xs font-medium transition-colors',
													isCurrent
														? 'bg-slate-900 text-white'
														: 'text-slate-700 hover:bg-slate-100 hover:text-slate-900',
												]}
											>
												<span>{routeItem.navLabel}</span>
												<span
													class:list={[
														'text-[11px] tabular-nums',
														isCurrent ? 'text-emerald-300' : 'text-slate-400',
													]}
												>
													{routeItem.defaultInput.billingCurrency} to {routeItem.defaultInput.payoutCurrency}
												</span>
											</a>
										);
									})
								}
							</nav>
							<div class="mt-2.5 flex flex-wrap gap-3 border-t border-slate-100 px-2 pt-2.5 text-xs font-medium text-slate-600">
								<a href="/about/" class="hover:text-slate-900 hover:underline">
									About &amp; Methodology
								</a>
								<a href="/privacy/" class="hover:text-slate-900 hover:underline">
									Privacy
								</a>
								<a href="/terms/" class="hover:text-slate-900 hover:underline">
									Terms
								</a>
							</div>
						</div>
					</details>
				</div>
			</div>
		</header>

		<main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:py-10">
			<slot />
		</main>

		<footer class="mt-16 border-t border-slate-200 bg-white text-sm text-slate-600">
			<div class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
				<div class="grid gap-8 md:grid-cols-12">
					<div class="space-y-3 md:col-span-5">
						<div class="inline-flex items-center gap-2">
							<span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-slate-900 text-[11px] font-bold text-emerald-400">
								FX
							</span>
							<p class="font-bold tracking-tight text-slate-900">ContractorFX</p>
						</div>
						<p class="text-xs leading-relaxed text-slate-600">
							Independent fee-drag and FX spread workbench for international contractors and global finance teams. Every invoice scenario, corridor comparison, and batch CSV payroll audit executes inside your browser with zero server uploads.
						</p>
						<p class="inline-flex items-center gap-1.5 rounded-md border border-emerald-200 bg-emerald-50/70 px-2.5 py-1 text-[11px] font-semibold text-emerald-800">
							<span>100% Local Payroll Privacy</span>
						</p>
					</div>

					<div class="space-y-2.5 md:col-span-4">
						<p class="text-xs font-bold uppercase tracking-wider text-slate-900">
							Corridor Benchmarks
						</p>
						<ul class="grid grid-cols-1 gap-1.5 text-xs">
							{
								ROUTE_PRESETS.map((routeItem) => (
									<li>
										<a
											href={routeItem.path}
											class="text-slate-600 transition-colors hover:text-slate-900 hover:underline"
										>
											{routeItem.navLabel} ({routeItem.defaultInput.billingCurrency} to{' '}
											{routeItem.defaultInput.payoutCurrency})
										</a>
									</li>
								))
							}
						</ul>
					</div>

					<div class="space-y-2.5 md:col-span-3">
						<p class="text-xs font-bold uppercase tracking-wider text-slate-900">
							Trust &amp; Discovery
						</p>
						<ul class="grid grid-cols-1 gap-1.5 text-xs font-medium">
							<li>
								<a href="/about/" class="text-slate-700 hover:text-slate-900 hover:underline">
									About &amp; Fee Methodology
								</a>
							</li>
							<li>
								<a href="/privacy/" class="text-slate-700 hover:text-slate-900 hover:underline">
									Privacy Policy
								</a>
							</li>
							<li>
								<a href="/terms/" class="text-slate-700 hover:text-slate-900 hover:underline">
									Terms &amp; Disclaimers
								</a>
							</li>
							<li>
								<a href="/llms.txt" class="text-slate-700 hover:text-slate-900 hover:underline">
									llms.txt
								</a>
							</li>
							<li>
								<a
									href="/sitemap-index.xml"
									class="text-slate-700 hover:text-slate-900 hover:underline"
								>
									XML Sitemap
								</a>
							</li>
						</ul>
					</div>
				</div>

				<div class="mt-8 space-y-2 border-t border-slate-200 pt-6 text-xs leading-relaxed text-slate-500">
					<p class="font-medium text-slate-700">
						Independent fee modeling tool; not financial or tax advice; not affiliated with Wise, Payoneer, Deel, or Remote.
					</p>
					<p>
						All trademarks and provider names belong to their respective owners and appear strictly for comparative fee analysis. Reference interbank mid-market rates and published provider fee schedules reflect Nov 2026 estimates; always verify live binding checkout quotes before initiating transfers.
					</p>
				</div>
			</div>
		</footer>
	</body>
</html>
