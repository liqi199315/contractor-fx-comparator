---
import BaseLayout from '../layouts/BaseLayout.astro';
import FxComparatorWorkbench from '../components/FxComparatorWorkbench.astro';
import { comparePayoutProviders } from '../lib/fx-engine';
import { getPresetBySlug, ROUTE_CARD_META, ROUTE_PRESETS } from '../lib/route-presets';

const preset = getPresetBySlug('');
if (!preset) {
	throw new Error('Missing root route preset');
}

const corridorRoutes = ROUTE_PRESETS.filter((item) => item.path !== preset.path);
const benchmarkSummary = comparePayoutProviders(preset.defaultInput);
const wiseQuote = benchmarkSummary.quotes.find((q) => q.providerId === 'wise')!;
const payoneerQuote = benchmarkSummary.quotes.find((q) => q.providerId === 'payoneer')!;

function fmtMoney(value: number): string {
	return value.toLocaleString('en-US', {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});
}
---

<BaseLayout
	title={preset.seoTitle}
	description={preset.metaDescription}
	canonicalPath={preset.path}
	faqs={preset.faqs}
>
	<div class="space-y-10 min-w-0">
		<FxComparatorWorkbench preset={preset} />

		{
			(preset.workedExample || preset.feeSources || preset.auditCallout) && (
				<section class="fintech-card rounded-2xl p-6 sm:p-8 space-y-6">
					<div class="space-y-2">
						<p class="text-xs font-bold uppercase tracking-wider text-emerald-800">
							Sources, formula, and a worked example
						</p>
						<h2 class="text-xl font-bold text-slate-900 sm:text-2xl">
							{preset.workedExample?.heading ?? 'Published fee sources'}
						</h2>
					</div>

					{
						preset.auditCallout && (
							<p class="rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm leading-relaxed text-amber-950">
								{preset.auditCallout}
							</p>
						)
					}

					{
						preset.workedExample && (
							<div class="space-y-3">
								<p class="rounded-lg border border-slate-200 bg-white px-3 py-2 font-mono text-xs font-semibold text-slate-900 sm:text-sm">
									{preset.workedExample.formula}
								</p>
								<ol class="list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-700">
									{preset.workedExample.steps.map((step) => (
										<li>{step}</li>
									))}
								</ol>
							</div>
						)
					}

					{
						preset.feeSources && preset.feeSources.length > 0 && (
							<div class="space-y-3">
								<h3 class="text-base font-bold text-slate-900">Fee sources and verification dates</h3>
								<div class="overflow-x-auto rounded-xl border border-slate-200">
									<table class="min-w-full divide-y divide-slate-200 text-left text-xs sm:text-sm">
										<thead class="bg-slate-50 font-semibold uppercase tracking-wide text-slate-600">
											<tr>
												<th scope="col" class="px-3 py-3">Source</th>
												<th scope="col" class="px-3 py-3">Verified</th>
												<th scope="col" class="px-3 py-3">What it states</th>
											</tr>
										</thead>
										<tbody class="divide-y divide-slate-200 bg-white text-slate-700">
											{preset.feeSources.map((source) => (
												<tr>
													<td class="px-3 py-3 align-top">
														<p class="font-semibold text-slate-900">{source.publisher}</p>
														<a
															href={source.url}
															class="mt-1 inline-block font-medium text-slate-900 underline hover:text-emerald-800 break-all"
															{...(source.url.startsWith('http')
																? { target: '_blank', rel: 'noopener noreferrer' }
																: {})}
														>
															{source.pageTitle}
														</a>
													</td>
													<td class="px-3 py-3 align-top whitespace-nowrap tabular-nums">
														{source.verifiedOn}
													</td>
													<td class="px-3 py-3 align-top leading-relaxed">{source.finding}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							</div>
						)
					}

					{
						preset.relatedLinks && preset.relatedLinks.length > 0 && (
							<ul class="flex flex-col gap-2 text-sm font-medium text-slate-800">
								{preset.relatedLinks.map((link) => (
									<li>
										<a href={link.href} class="underline hover:text-emerald-800">
											{link.label}
										</a>
									</li>
								))}
							</ul>
						)
					}
				</section>
			)
		}

		<section class="fintech-card rounded-2xl p-6 sm:p-8 space-y-6">
			<div class="space-y-2">
				<p class="text-xs font-bold uppercase tracking-wider text-emerald-800">
					Transparent Treasury Math
				</p>
				<h2 class="text-xl font-bold text-slate-900 sm:text-2xl">
					How Hidden FX Spreads Work
				</h2>
				<p class="max-w-3xl text-sm leading-relaxed text-slate-600">
					Many international contractor platforms advertise zero transfer fees while embedding a 150 to 260 basis-point (1.50% to 2.60%) margin inside the retail exchange rate. Separating explicit fees from implicit conversion loss exposes the true cost of each payout rail.
				</p>
				{
					preset.corridorContextNote && (
						<p class="max-w-3xl text-sm leading-relaxed text-slate-700 font-medium pt-1">
							{preset.corridorContextNote}
						</p>
					)
				}
			</div>

			<div class="grid gap-4 md:grid-cols-3">
				<div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 space-y-2">
					<p class="text-xs font-bold uppercase tracking-wide text-slate-500">
						Step 1. Spread in Basis Points
					</p>
					<p class="rounded-lg border border-slate-200 bg-white px-3 py-2 font-mono text-xs font-semibold text-slate-900">
						Spread % = (Mid Rate - Retail Rate) / Mid Rate
					</p>
					<p class="text-xs leading-relaxed text-slate-600">
						One percentage point equals 100 basis points (bps). When USD/INR trades at 84.40 interbank and a platform settles at 82.50, the hidden markup is 2.25% (225 bps).
					</p>
				</div>

				<div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 space-y-2">
					<p class="text-xs font-bold uppercase tracking-wide text-slate-500">
						Step 2. Hidden FX Loss in USD
					</p>
					<p class="rounded-lg border border-slate-200 bg-white px-3 py-2 font-mono text-xs font-semibold text-slate-900">
						FX Loss $ = Principal $ x (Spread bps / 10,000)
					</p>
					<p class="text-xs leading-relaxed text-slate-600 tabular-nums">
						Unlike flat wire fees, spread loss scales linearly with invoice volume. At 225 bps, a $3,500.00 invoice loses ${fmtMoney(payoneerQuote.fxLossUsd)} to conversion markup alone.
					</p>
				</div>

				<div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 space-y-2">
					<p class="text-xs font-bold uppercase tracking-wide text-slate-500">
						Step 3. Total All-In Fee Drag
					</p>
					<p class="rounded-lg border border-slate-200 bg-white px-3 py-2 font-mono text-xs font-semibold text-slate-900">
						Total Drag $ = Seat $ + Rail $ + FX Loss $
					</p>
					<p class="text-xs leading-relaxed text-slate-600 tabular-nums">
						Adding SaaS subscriptions and ACH or wire charges yields real per-invoice leakage: ${fmtMoney(wiseQuote.totalFeeDragUsd)} on Wise ({Math.round(wiseQuote.effectiveFeePct * 100)} bps) vs ${fmtMoney(payoneerQuote.totalFeeDragUsd)} on Payoneer ({Math.round(payoneerQuote.effectiveFeePct * 100)} bps).
					</p>
				</div>
			</div>
			<p class="text-sm leading-relaxed text-slate-600">
				To price a rate on a bank receipt, use the
				<a href="/fx-markup-calculator/" class="font-medium text-slate-900 underline hover:text-emerald-800">FX markup calculator</a>.
				Indian payees checking a Payoneer INR withdrawal should use the
				<a href="/payoneer-fees-calculator-india/" class="font-medium text-slate-900 underline hover:text-emerald-800">Payoneer India fee band</a>.
			</p>
		</section>

		<section class="fintech-card rounded-2xl p-6 sm:p-8 space-y-6">
			<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
				<div class="space-y-1">
					<p class="text-xs font-bold uppercase tracking-wider text-slate-500">
						Dedicated Scenario Calculators
					</p>
					<h2 class="text-xl font-bold text-slate-900 sm:text-2xl">
						Popular Payout Corridors &amp; Platform Comparisons
					</h2>
				</div>
				<p class="text-xs text-slate-600">
					Pre-configured benchmarks for solo freelancers, engineering teams, and CFO audits
				</p>
			</div>

			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					corridorRoutes.map((item) => {
						const meta = ROUTE_CARD_META[item.path];
						return (
							<a
								href={item.path}
								class="group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 transition-all hover:border-slate-400 hover:bg-slate-50/80"
							>
								<div class="space-y-2.5">
									<div class="flex flex-wrap items-center justify-between gap-2">
										<span class="rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-900">
											{meta?.audienceTag ?? 'Benchmark'}
										</span>
										<span class="rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 tabular-nums">
											{meta?.corridorBadge ?? `${item.defaultInput.billingCurrency} -> ${item.defaultInput.payoutCurrency}`}
										</span>
									</div>
									<h3 class="text-base font-bold text-slate-900 group-hover:text-emerald-800">
										{item.navLabel}
									</h3>
									<p class="text-xs leading-relaxed text-slate-600">
										{meta?.comparisonFocus ?? item.heroSummary}
									</p>
								</div>
								<div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-xs font-semibold text-slate-800 tabular-nums">
									<span>
										${fmtMoney(item.defaultInput.invoiceAmount)} {item.defaultInput.billingCurrency} ({item.defaultInput.contractorCount} {item.defaultInput.contractorCount === 1 ? 'seat' : 'seats'})
									</span>
									<span class="text-emerald-700 group-hover:translate-x-0.5 transition-transform">
										Open -&gt;
									</span>
								</div>
							</a>
						);
					})
				}
			</div>
		</section>

		<section class="grid gap-6 lg:grid-cols-2">
			<div class="fintech-card rounded-2xl p-6 space-y-4">
				<h2 class="text-lg font-bold text-slate-900">
					Corridor Rate and Fee Methodology
				</h2>
				<ul class="space-y-2.5 text-sm leading-relaxed text-slate-700 list-disc pl-5">
					{preset.methodologyNotes.map((note) => <li>{note}</li>)}
				</ul>
				<p class="rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs text-slate-600">
					Reference mid-market rates and published schedule estimates as of Nov 2026; verify live checkout quotes before initiating transfers.
				</p>
			</div>

			<div class="fintech-card rounded-2xl p-6 space-y-4">
				<h2 class="text-lg font-bold text-slate-900">
					Audit Verification &amp; Privacy Standards
				</h2>
				<dl class="space-y-3 text-sm">
					<div class="rounded-lg border border-slate-200/80 bg-slate-50/60 p-3.5 space-y-1">
						<dt class="font-semibold text-slate-900">Published Schedule Provenance</dt>
						<dd class="text-xs leading-relaxed text-slate-600">
							Fee models reflect November 2026 public business tariffs for Wise Business, Payoneer, Deel ($49/seat), Remote ($29/seat), and standard correspondent SWIFT bank wires.
						</dd>
					</div>
					<div class="rounded-lg border border-slate-200/80 bg-slate-50/60 p-3.5 space-y-1">
						<dt class="font-semibold text-slate-900">Zero-Upload Browser Isolation</dt>
						<dd class="text-xs leading-relaxed text-slate-600">
							Invoice inputs, custom spot overrides, and team CSV payroll rosters execute strictly inside local browser memory. Compensation figures and recipient names never leave your device.
						</dd>
					</div>
					<div class="rounded-lg border border-slate-200/80 bg-slate-50/60 p-3.5 space-y-1">
						<dt class="font-semibold text-slate-900">Controller Sign-Off Artifacts</dt>
						<dd class="text-xs leading-relaxed text-slate-600">
							Every calculation exports directly to Markdown routing memos and structured CSV tables so finance teams can archive pre-transfer rate checks alongside monthly AP records.
						</dd>
					</div>
					{
						preset.clearingRailInfo && (
							<div class="rounded-lg border border-emerald-200/80 bg-emerald-50/60 p-3.5 space-y-1">
								<dt class="font-semibold text-emerald-950">Local Clearing Rail Architecture</dt>
								<dd class="text-xs leading-relaxed text-emerald-900">
									{preset.clearingRailInfo}
								</dd>
							</div>
						)
					}
				</dl>
			</div>
		</section>

		<section class="fintech-card rounded-2xl p-6 sm:p-8 space-y-6">
			<h2 class="text-xl font-bold text-slate-900">
				Frequently Asked Questions
			</h2>
			<dl class="divide-y divide-slate-200">
				{
					preset.faqs.map((faq) => (
						<div class="py-4 first:pt-0 last:pb-0 space-y-1.5">
							<dt class="text-base font-semibold text-slate-900">{faq.question}</dt>
							<dd class="text-sm leading-relaxed text-slate-600">{faq.answer}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>
</BaseLayout>
