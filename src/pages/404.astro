---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTE_CARD_META, ROUTE_PRESETS } from '../lib/route-presets';
---

<BaseLayout
	title="Page Not Found | PayoutSpread Contractor FX Comparator"
	description="The requested contractor payout route was not found. Select a verified FX spread calculator below or run a 100% browser-local team CSV fee audit."
	canonicalPath="/404/"
	noindex={true}
>
	<section class="mx-auto max-w-4xl fintech-card rounded-2xl p-6 sm:p-8 space-y-6">
		<div class="space-y-2.5">
			<div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-slate-700">
				<span>HTTP 404</span>
				<span aria-hidden="true">/</span>
				<span>Route Missing</span>
			</div>
			<h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
				Corridor Page Not Found
			</h1>
			<p class="max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
				That payout benchmark URL does not exist. Open one of the six verified contractor FX calculators or run a client-side CSV roster audit below.
			</p>
			<div class="flex flex-wrap gap-3 pt-1">
				<a
					href="/"
					class="inline-flex min-h-11 items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800"
				>
					Open Global FX Calculator
				</a>
				<a
					href="/batch-contractor-payout-csv-audit/"
					class="inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-50"
				>
					Run Team CSV Audit
				</a>
			</div>
		</div>

		<div class="border-t border-slate-200 pt-6 space-y-3">
			<h2 class="text-base font-bold text-slate-900">
				Verified Payout Corridors &amp; Platform Calculators
			</h2>
			<div class="grid gap-3.5 sm:grid-cols-2">
				{
					ROUTE_PRESETS.map((item) => {
						const meta = ROUTE_CARD_META[item.path];
						return (
							<a
								href={item.path}
								class="group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 transition-all hover:border-slate-400 hover:bg-slate-50/70"
							>
								<div class="space-y-1.5">
									<div class="flex flex-wrap items-center justify-between gap-2">
										<span class="text-sm font-bold text-slate-900 group-hover:text-emerald-800">
											{item.navLabel}
										</span>
										{meta && (
											<span class="rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700 tabular-nums">
												{meta.corridorBadge}
											</span>
										)}
									</div>
									<p class="text-xs leading-relaxed text-slate-600">{item.h1}</p>
								</div>
								{meta && (
									<p class="mt-3 text-[11px] font-medium text-emerald-800">
										{meta.spreadRangeNote}
									</p>
								)}
							</a>
						);
					})
				}
			</div>
		</div>
	</section>
</BaseLayout>
